# TimeTrack environment — fill in values below.
# This file is gitignored and must never be committed.
# The "App runtime" sections below also go into HF Space secrets (Settings → Variables and
# secrets) at deploy time. The "Deployment" section is local-only tooling config — it is NOT
# consumed by the running app and does NOT need to be set as a Space secret.

# ============================================================
# Deployment (local tooling only — git remotes, pushing to the Space)
# ============================================================

# GitHub (or other) repo URL for this project's source, e.g. https://github.com/you/timetrack.git
GIT_REPO_URL=

# Public URL of the HF Space, e.g. https://huggingface.co/spaces/<username>/<space-name>
HF_SPACE_URL=

# HF Space git remote is derived from HF_SPACE_URL as:
#   https://huggingface.co/spaces/<username>/<space-name>
# (same URL — Spaces serve their git remote at that address). Used by a deploy script to
# `git push` your build to the Space.

# HF access token with write access — used ONLY locally, as the password when git-pushing
# to the Space remote (username = your HF username, password = this token), and by
# huggingface_hub if any deploy script manages the Space or bucket programmatically.
# Create one at https://huggingface.co/settings/tokens (Write role).
HF_TOKEN=

# ============================================================
# App runtime — Auth (single user)
# ============================================================
# Plain username you'll log in with.
AUTH_USERNAME=
# Bcrypt hash of your password — generate with: python scripts/hash_password.py
# Never put a plaintext password here.
AUTH_PASSWORD_HASH=
# Random signing secret for login session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ============================================================
# App runtime — Timezone
# ============================================================
# IANA timezone used for all "what calendar day is it" logic (clock-in/out bucketing,
# calendar month boundaries).
APP_TIMEZONE=Asia/Kolkata

# ============================================================
# App runtime — LLM summarization (leave both keys blank to disable summaries)
# ============================================================
# Automatic fallback chain, not a manual switch: OpenAI (gpt-4o-mini) is tried first
# when configured; Anthropic (Haiku) is used if OpenAI has no key, has no credit, or
# the call otherwise fails. Either key alone is also enough to run.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ============================================================
# App runtime — Persistence
# ============================================================
# Local ephemeral path where the live SQLite file runs (must NOT be on the mounted bucket).
DB_PATH=/tmp/timetrack.db
# Mounted HF Storage Bucket path (durable). Whole-file backups are written here after
# every mutation. If unset or unmounted, the app runs local-only with a startup warning.
DATA_DIR=/data
# How many daily snapshots to retain under DATA_DIR/snapshots/.
BACKUP_RETAIN_DAYS=14
